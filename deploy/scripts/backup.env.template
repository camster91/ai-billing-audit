# shellcheck shell=sh
# /etc/ashbi/backup.env — operator config for ai-billing-audit backups
# ============================================================================
# This file is read by /usr/local/bin/audit-backup.sh and
# /usr/local/bin/audit-restore-verify.sh. Every variable has a default in
# the script, so this file only needs to declare the values you want to
# override. Restart cron after editing (cron re-reads /etc/cron.d/* on
# changes, but it's harmless to confirm).
#
# Generate the rclone remote with one of:
#   rclone config create ai-billing-backup b2   account XXXX key XXXX
#       --b2-bucket ai-billing-audit-backups
#   rclone config create ai-billing-backup s3   provider Other access_key_id XXXX
#       secret_access_key XXXX endpoint https://s3.us-east-1.example.com
#   rclone config create ai-billing-backup s3   provider AWS env_auth true region us-east-1
# ============================================================================

# --- Object store (REQUIRED) --------------------------------------------------
# rclone remote name (run `rclone listremotes` to see what's configured).
# This config sets defaults ONLY if the caller did not pass an env var. To
# override on a single run, use: `RCLONE_REMOTE=foo /usr/local/bin/audit-backup.sh`
[ -z "${RCLONE_REMOTE:-}" ] && export RCLONE_REMOTE=ai-billing-backup

# Bucket / container name on the remote
[ -z "${RCLONE_BUCKET:-}" ] && export RCLONE_BUCKET=ai-billing-audit-backups

# Top-level prefix inside the bucket; change to namespace per environment
[ -z "${RCLONE_PREFIX:-}" ] && export RCLONE_PREFIX=pgdumps

# --- Source (defaults match the prod stack; rarely needs to change) ---------
[ -z "${PG_CONTAINER:-}" ] && export PG_CONTAINER=ai-billing-audit-postgres
[ -z "${PG_USER:-}" ] && export PG_USER=audit
[ -z "${PG_DB:-}" ] && export PG_DB=ai_billing_audit

# --- Age encryption (REQUIRED) -----------------------------------------------
[ -z "${AGE_PUB:-}" ] && export AGE_PUB=/etc/ashbi/backup.age.pub
[ -z "${AGE_KEY:-}" ] && export AGE_KEY=/etc/ashbi/backup.age.key

# --- Alerting (optional) ------------------------------------------------------
# Leave ALERT_WEBHOOK_URL empty to disable alerting (everything still logs
# to /var/log/ai-billing-audit/backup.log). Set to a URL that accepts
# POST with a JSON body; the script sends:
#   {"source":"ai-billing-audit-backup","severity":"...","message":"..."}
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/.../...

# --- Misc ---------------------------------------------------------------------
# Drop alert when the new weekly/monthly size is >= this % smaller than the
# prior week's. 50 catches "the dump silently stopped including a table".
[ -z "${SIZE_DROP_PCT:-}" ] && export SIZE_DROP_PCT=50

# --- Restore-verify only ------------------------------------------------------
# Minimum audit_trail row count in the restored dump. The v1 stack seeds
# the table on first encounter upload, so 1 is fine for now. Bump this
# if you want to assert "there must be at least N events from the last
# N days" in the verification.
[ -z "${MIN_AUDIT_TRAIL_ROWS:-}" ] && export MIN_AUDIT_TRAIL_ROWS=1

# Final guard: ensure this file exits 0 even when every conditional
# above short-circuits. Required because the scripts source this file
# with `set -e`, and `. <file>` returns the exit code of the LAST command
# in the file. Without this, a single short-circuit would terminate the
# whole backup script. Also makes the file safe to source in isolation
# for ad-hoc operator checks.
: "${RCLONE_REMOTE:=ai-billing-backup}"
true
