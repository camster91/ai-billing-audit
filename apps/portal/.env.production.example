# apps/portal/.env.production.example
#
# Production env template for the Zorva marketing portal.
#
# The deploy script (deploy-portal.sh) reads this file, fills in the
# blanks with values sourced from /root/ai-billing-audit-secrets/
# on the VPS host (parallel to the FastAPI secrets pattern), and writes
# the result to /opt/projects/ai-billing-audit/portal/.env with
# chmod 600. The portal container then reads it via docker-compose
# env_file.
#
# DO NOT commit the populated .env to git. The deploy script refuses to
# overwrite if the file already exists with chmod 600 (operator action
# to rotate a secret).

# ---- Database ---------------------------------------------------------
# The portal uses Postgres in prod (sqlite only in dev). Points at the
# portal-postgres service in docker-compose.yml. The user/password here
# must match POSTGRES_PASSWORD in the portal-postgres service block (the
# deploy script sources both from the same host secret file).
DATABASE_URL="postgresql://portal:CHANGE_ME@portal-postgres:5432/zorva_portal?schema=public"

# ---- Auth --------------------------------------------------------------
# AUTH_SECRET: NextAuth.js v5 JWT signing secret. 32+ random bytes.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# AUTH_RESEND_KEY: Resend API key for magic-link sign-in emails.
# Sourced from /root/ai-billing-audit-secrets/resend_api_key
AUTH_RESEND_KEY=""

# AUTH_EMAIL_FROM: sender address (must be verified in the Resend dashboard).
AUTH_EMAIL_FROM="AI Billing Portal <noreply@ashbi.ca>"

# ---- Stripe -----------------------------------------------------------
# The portal's billing flows (Checkout, Customer Portal, webhooks) all
# hit Stripe. Three keys:
#   - secret: server-side, used by /api/billing/* routes
#   - publishable: client-side, safe to expose to the browser
#   - webhook signing secret: rotated per Stripe webhook endpoint
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Pricing ----------------------------------------------------------
# Anchors the 3-tier pricing page. The portal reads these at request
# time and renders the price in the currency selected by the visitor
# (PRICING_CURRENCY_PRIMARY is the default; SECONDARY shown alongside).
PRICING_CURRENCY_PRIMARY="CAD"
PRICING_CURRENCY_SECONDARY="USD"

PRICING_TIER_SMALL_NAME="Small practice"
PRICING_TIER_SMALL_AUDIT_CAP="500"
PRICING_TIER_SMALL_PRICE_CAD="499"
PRICING_TIER_SMALL_PRICE_USD="369"
PRICING_TIER_SMALL_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_SMALL_STRIPE_PRICE_ID_USD=""

PRICING_TIER_MID_NAME="Mid clinic"
PRICING_TIER_MID_AUDIT_CAP="2000"
PRICING_TIER_MID_PRICE_CAD="1499"
PRICING_TIER_MID_PRICE_USD="1109"
PRICING_TIER_MID_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_MID_STRIPE_PRICE_ID_USD=""

PRICING_TIER_LARGE_NAME="Large practice"
PRICING_TIER_LARGE_AUDIT_CAP="5000"
PRICING_TIER_LARGE_PRICE_CAD="2999"
PRICING_TIER_LARGE_PRICE_USD="2219"
PRICING_TIER_LARGE_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_LARGE_STRIPE_PRICE_ID_USD=""

# Comma-separated emails allowed to PUT /api/billing/tiers.
# Fail-closed when unset (route returns 503).
PLATFORM_ADMIN_EMAILS=""
