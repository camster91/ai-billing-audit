// Prisma schema for the client portal.
//
// Two model groups live here:
//   1. NextAuth.js (Auth.js v5) PrismaAdapter models:
//      User, Account, Session, VerificationToken, Authenticator
//      Shapes and compound unique keys are dictated by @auth/prisma-adapter.
//   2. Tenant / Membership models for clinic orgs and the user↔tenant join.
//
// Database: dev is sqlite (no infra). Production target is PostgreSQL
// (ca-central-1 or us-east-1 per the ai-billing-audit board spec). The
// schema is written so the same models work on both — only the datasource
// provider block changes between environments.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// NextAuth.js / Auth.js v5 models
// Required shape: @auth/prisma-adapter reads/writes these tables directly.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  memberships    Membership[]
  redeemedSessions RedeemedCheckoutSession[]
  actionedFindings Finding[]
  platformRole PlatformUserRole?
  platformAuditEvents PlatformAuditEvent[] @relation("PlatformAuditActor")
  leadActivities LeadActivity[] @relation("LeadActivityActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Company-wide authorization is deliberately separate from Membership.role.
// A clinic owner/admin never receives platform access by implication.
model PlatformUserRole {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String
  active    Boolean  @default(true)
  grantedBy String
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, active])
}

// Application-append-only company-operator access and action record. This is
// separate from the tenant-scoped clinical AuditTrailEntry hash chain and
// carries no PHI. Database immutability/retention controls remain a release gate.
model PlatformAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  action      String
  targetType  String
  targetId    String?
  requestId   String   @unique
  metadataJson String?
  occurredAt  DateTime @default(now())

  actor User? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([action, occurredAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Active tenant selected for this session — written by the tenant-scope
  // middleware. Null when the user has memberships but hasn't picked one
  // yet (caller falls back to the first membership).
  activeTenantId String?
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Optional WebAuthn table — required by the adapter if you use the
// WebAuthn provider, harmless to keep otherwise.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ---------------------------------------------------------------------------
// Tenant / Membership models — the clinic org tree.
// ---------------------------------------------------------------------------

// SQLite note: Prisma + SQLite does not support native enums (no ENUM type).
// We model these as String fields and validate at the app layer
// (src/lib/tenant.ts). When you switch the datasource to PostgreSQL for
// production, you can convert these to real Prisma enums and add Zod
// validation that mirrors the enum shape.
//
//   tenant.tier:                "small" | "mid" | "large"
//   tenant.subscriptionStatus:  "active" | "past_due" | "canceled"
//   membership.role:            "owner" | "auditor" | "viewer"
//                              (admin is legacy and persisted for back-compat;
//                               new invites only allow owner | auditor | viewer)
//   membership.status:          "pending" | "active" | "inactive"
//   encounter.status:           "pending" | "auditing" | "awaiting_review" | "completed"
//   finding.category:           "em_level" | "documentation" | "medical_necessity" | "modifier" | "code_mismatch" | "payer_policy" | "other"
//   finding.status:             "pending" | "accepted" | "dismissed"
//   finding.dismissReason:      "wrong_payer_policy" | "hallucinated_fact" | "too_conservative" | "other_with_text"
//
// The valid value sets are exported from src/lib/encounter-types.ts
// alongside Zod schemas — see that file for the canonical lists.

model Tenant {
  id                 String   @id @default(cuid())
  // Display name for the clinic / org.
  name               String
  // URL-safe slug — used in the /t/<slug> namespace if we add public
  // tenant-scoped routes later. Unique to prevent slug collisions.
  slug               String   @unique
  // Sizing bucket — drives the audit_quota_limit default if not overridden.
  tier               String   @default("small")
  // Stripe billing linkage.
  // - stripeCustomerId: set on first Checkout Session completion (or on
  //   Customer Portal open). Unique — one customer per tenant.
  // - stripeSubscriptionId: set on the first invoice.paid / customer.subscription.created
  //   event after checkout. Null between checkout completion and the first
  //   invoice webhook arriving.
  // - subscriptionStatus mirrors the Stripe status string ("active",
  //   "past_due", "canceled", etc.). Defaults to "active" so manually-seeded
  //   tenants don't appear trialing.
  subscriptionStatus String   @default("active")
  stripeCustomerId   String?  @unique
  stripeSubscriptionId String? @unique
  // Audit quota tracking — the billing-audit engine increments
  // audit_quota_used on each claim submitted for review; the portal UI
  // surfaces used/limit and warns near the cap. See
  // src/lib/audit-quota.ts for the server-side enforcement (atomic
  // check-and-increment at 80% warn / 100% block, reset on
  // invoice.payment_succeeded).
  auditQuotaUsed     Int      @default(0)
  // Audit slots reserved by portal requests that have not yet received a
  // durable engine job id. Reservations count against the cap without being
  // billed as usage; successful enqueue atomically moves one slot to used.
  auditQuotaReserved Int      @default(0)
  auditQuotaLimit    Int      @default(100)
  // First day (UTC) of the billing period in which the 80% warning
  // email was last sent. Null until the first warning fires. Used to
  // dedupe — the 80% threshold is "warn once per period", not
  // "warn on every audit that crosses 80%".
  quotaWarningSentAt DateTime?
  // Start of the billing period (UTC date) that the most recent
  // quota reset applied to. The webhook handler skips the reset when
  // the new event would write to the same period as a prior reset —
  // this is the "no double-reset within the same period" invariant.
  // Null until the first reset fires.
  lastQuotaResetPeriodStart DateTime?

  // -----------------------------------------------------------------------
  // Subscription lifecycle (t_c12cf722). Populated by the Stripe webhook
  // handlers in src/app/api/billing/webhook/route.ts.
  //
  // canceledAt: set on customer.subscription.deleted. A nightly
  //   cleanup job (scripts/purge-canceled-tenants.ts) hard-deletes
  //   tenants whose canceledAt is older than the retention window
  //   (default 30 days). Within that window the tenant data stays in
  //   place so the owner can still sign in and re-subscribe without a
  //   cold start.
  //
  // firstPaymentFailureAt: timestamp of the FIRST consecutive
  //   invoice.payment_failed event for this tenant. Stays set across
  //   subsequent failures in the same streak; cleared the moment a
  //   payment succeeds (invoice.payment_succeeded handler). The
  //   past_due transition fires only when the failure streak is
  //   older than 3 days (PAYMENT_FAILURE_GRACE_DAYS in the webhook
  //   handler).
  //
  // lastPaymentFailureAt: timestamp of the most recent failure. Lets
  //   the dashboard surface "X days of payment failure" without
  //   re-counting from firstPaymentFailureAt.
  // -----------------------------------------------------------------------
  canceledAt                 DateTime?
  firstPaymentFailureAt     DateTime?
  lastPaymentFailureAt      DateTime?

  // -----------------------------------------------------------------------
  // First-run onboarding fields (t_84668464). Populated by the
  // /portal/onboarding wizard after Stripe Checkout success.
  //
  // clinicName: duplicated from `name` (the canonical display name) so
  //   the wizard can capture a separate human-readable clinic name on
  //   step 2 without forcing the stripe-derived default. Falls back to
  //   `name` when the user skips the rename.
  //
  // clinicNpi + clinicTimezone: optional. clinicNpi is the billing NPI
  //   (10-digit US NPI; for non-US clinics we accept any 6–15 char
  //   alphanumeric). clinicTimezone is an IANA tz string (e.g.
  //   "America/Toronto") used to default the encounter date picker.
  //
  // dataResidencyRegion: "ca-central-1" | "us-east-1" | null. Set on
  //   step 3. residencyRegionLocked flips to true on wizard completion
  //   — once locked, the /settings page must not allow changes.
  //
  // ehrConnectionMode: "sftp" | "manual" | null. Set on step 4.
  //   - "sftp": ehrSftpHost/Port/Username must be populated.
  //   - "manual": the user explicitly skipped SFTP, opting to upload
  //     837P files through the encounter upload UI.
  //
  // firstEncounterUploadMode: "uploaded" | "skipped" | null. Set on
  //   step 5. When "uploaded", firstEncounterFilePath points at a
  //   server-staged 837P file ready for the audit pipeline.
  // -----------------------------------------------------------------------
  clinicName                 String?
  // Free-form mailing address. No per-field validation (suite number,
  // province code, postal pattern varies by country); bounded to 500
  // chars so the row can't grow unbounded. Optional.
  clinicAddress              String?
  clinicNpi                  String?
  clinicTimezone             String?
  dataResidencyRegion        String?
  residencyRegionLocked      Boolean  @default(false)
  ehrConnectionMode          String?
  ehrSftpHost                String?
  ehrSftpPort                Int?
  ehrSftpUsername            String?
  // SFTP password/passphrase is stored as a ciphertext blob (envelope
  // encrypted by KMS in production; raw for the dev fixture). Never
  // returned via the API.
  ehrSftpPasswordCiphertext  String?
  firstEncounterUploadMode   String?
  firstEncounterFilePath     String?
  firstEncounterFileName     String?
  firstEncounterUploadedAt   DateTime?

  // -----------------------------------------------------------------------
  // /settings page (t_1bab62b6) — clinic-level preferences editable
  // from the post-onboarding settings surface.
  //
  // redactPatientNamesInExports: when true, the /api/encounters/export
  //   and /api/findings/export routes replace the per-row patient hash
  //   prefix with "[redacted]" so downstream spreadsheets don't carry
  //   the SHA-256 fingerprint that ties a row back to a patient
  //   identifier. Defaults to on — the spec requires the safe-by-default
  //   posture; clinics that need unredacted exports (e.g. for in-house
  //   reconciliation with the EMR) can toggle it off.
  // -----------------------------------------------------------------------
  redactPatientNamesInExports Boolean @default(true)

  // onboardingStep: 0 (not started) → 1 (clinic profile) → 2 (region) →
  // 3 (EHR) → 4 (first encounter) → 5 (complete). Persisted so a
  // returning user lands on the right step.
  // onboardingCompletedAt: timestamp the wizard completed. Null until
  // then.
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  // First-audit-complete email (t_a0c9352e). Set the first time we
  // dispatch the "your first audit is ready" email for this tenant.
  // Acts as a dedup key — every call to maybeSendFirstAuditComplete
  // short-circuits when this is non-null, so a tenant that ingests
  // encounters in batches across multiple FastAPI runs only gets
  // the email once.
  firstAuditEmailSentAt  DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships Membership[]
  encounters  Encounter[]
  auditDispatches AuditDispatch[]
  auditEntries AuditTrailEntry[]
  redeemedSessions RedeemedCheckoutSession[]
  invoices    Invoice[]
  processedStripeEvents ProcessedStripeEvent[]
}

// Stripe checkout session redemption ledger.
//
// One row per Stripe Checkout Session ID that the onboarding wizard
// has "redeemed" — i.e. the user signed in and we attached them as the
// owner Membership of the tenant created from the session. The unique
// sessionId index dedupes the redemption at the DB layer; the wizard's
// GET handler uses this to recognize "you've already started" without
// having to re-query Stripe on every page load.
//
// The wizard DOES NOT need this row to also bind a tenant; the
// webhook's checkout.session.completed handler already creates the
// Tenant from the same session. The ledger exists purely for
// membership-attachment idempotency.
model RedeemedCheckoutSession {
  id            String   @id @default(cuid())
  // Stripe's Checkout Session id (cs_xxx). For demo-mode flows the
  // wizard writes a synthetic "demo_xxx" id here instead.
  sessionId     String   @unique
  // User who claimed owner role.
  userId        String
  // Tenant the user was attached to.
  tenantId      String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// Join table: a user can belong to many tenants (e.g. a billing consultant
// who works across multiple clinics) and a tenant can have many users.
// `role` is the per-tenant role; the global superadmin flag is intentionally
// absent here (out of scope for this milestone).
model Membership {
  id    String @id @default(cuid())
  userId String?
  tenantId String
  // Role for this (user, tenant) pair. New invites only set
  // owner | auditor | viewer; the existing "admin" value is
  // preserved in the database for back-compat but is treated as
  // equivalent to "owner" by the role enforcement helper.
  role      String   @default("viewer")
  // Team-management status. "pending" = invite issued, user has
  // not accepted; "active" = bound to a User row with a session;
  // "inactive" = soft-disabled, treated as no longer a member
  // for the purposes of tenant-scoped APIs.
  status    String   @default("active")
  // Captured at invite time. Stays set after activation so audit
  // shows the original invited address even if the user later
  // changes their account email.
  email     String
  // One-time magic-link token for the invite. Null once the
  // membership is no longer "pending". Indexed for the accept
  // route's lookup.
  inviteToken String? @unique
  invitedAt   DateTime  @default(now())
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Encounter / Finding / Audit models — the client-portal review surface.
//
// `Encounter` is a single billable visit: clinical narrative (free text),
// a structured billed `EncounterClaim` (CPT codes, payer, provider, charge),
// and zero-to-many `Finding`s the AI auditor produced against the encounter.
//
// `Finding` carries the auditor's verdict on a specific billing concern:
// current_code -> suggested_code, evidence_quote (the span in the
// narrative the finding is anchored to), the rule reference, the
// estimated financial impact, and a status (pending / accepted / dismissed).
//
// `AuditTrailEntry` is the append-only log of every reviewer action
// (accept / dismiss) and the hash chain signature that closes it. The
// chain shape is documented in src/lib/audit-chain.ts; the SQL DDL for
// the production Postgres is in audit_trail.sql at the repo root.
//
// All status / category / reason columns are plain `String` because
// SQLite has no enum type. The valid value sets are exported as TS
// string-literal unions from src/lib/encounter-types.ts and validated
// with Zod at the route boundary.
// ---------------------------------------------------------------------------

model Encounter {
  id            String   @id @default(cuid())
  // Tenant isolation — every query joins through tenantId. Indexed for the
  // /encounters list (server-paginated) and the audit log filter.
  tenantId      String
  patientHash   String   // SHA-256 hex of patient identifier; never PII
  dateOfService DateTime
  specialty     String
  // AES-256-GCM ciphertext containing the free-text clinical narrative.
  // Authorized server-side readers decrypt it in memory only.
  clinicalNote  String
  // FK to the EncounterClaim row holding the structured billed claim JSON.
  // 1:1 — every encounter has exactly one billed claim at review time.
  claimId       String   @unique
  // "pending" | "auditing" | "awaiting_review" | "completed"
  status        String   @default("awaiting_review")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim         EncounterClaim @relation(fields: [claimId], references: [id])
  findings      Finding[]
  auditEntries  AuditTrailEntry[]
  auditDispatch AuditDispatch?

  @@index([tenantId, status, dateOfService])
  @@index([tenantId, dateOfService])
}

// Durable bridge between a portal encounter and the asynchronous audit
// engine. One encounter may be dispatched at most once; engineJobId provides
// the second idempotency boundary after the engine acknowledges the enqueue.
model AuditDispatch {
  id               String   @id @default(cuid())
  tenantId         String
  encounterId      String   @unique
  engineJobId      String?  @unique
  engineStatusUrl  String?
  status           String   @default("dispatching")
  quotaReserved    Boolean  @default(true)
  quotaChargedAt   DateTime?
  dispatchStartedAt DateTime @default(now())
  submittedAt      DateTime?
  completedAt      DateTime?
  resultImportedAt DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter        Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model EncounterClaim {
  id              String   @id @default(cuid())
  // Canonicalized payer / provider / NPI strings — these are the columns
  // the biller filters on in the /encounters list.
  payer           String
  providerNpi     String
  providerName    String
  // CPT code list, stored as JSON text. The portal renders this below the
  // clinical note; the auditor uses it to compute the financial impact.
  cptCodesJson    String   // JSON array of { code, modifier?, units? }
  // Total billed in cents (integer). Stored on EncounterClaim so the
  // list page can sum without joining through findings.
  billedCents     Int      @default(0)
  createdAt       DateTime @default(now())

  encounter       Encounter?
}

model Finding {
  id                       String   @id @default(cuid())
  encounterId              String
  // "em_level" | "documentation" | "medical_necessity" | "modifier" |
  // "code_mismatch" | "payer_policy" | "other". Drives the badge color
  // in the split-screen; billing_rule_reference is the human-readable
  // citation shown under the quote (e.g. "AMA CPT 2026 §99214").
  category                 String
  billingRuleReference     String
  // Suggested code change: the current code the biller filed with and
  // the auditor's recommended replacement (null when the finding is a
  // pure documentation / policy note, not a code swap).
  currentCode              String?
  suggestedCode            String?
  // AES-256-GCM ciphertext containing the span in encounter.clinicalNote.
  // The /encounters/[id] page wraps matching occurrences in a clickable
  // highlight span and scrolls the first one into view on demand.
  evidenceQuote            String
  // Estimated financial impact in cents. Positive = revenue the clinic
  // recovers if the change is applied; negative = revenue the clinic
  // gives up. Shown on the card as a signed dollar amount.
  estFinancialImpactCents  Int      @default(0)
  // "pending" | "accepted" | "dismissed". Reviewer disposition. Pending
  // is not yet acted on; accepted/dismissed is terminal — the portal
  // disallows undoing without writing a second audit row.
  status                   String   @default("pending")
  // Canonical machine-readable rule identifier from the auditor output
  // (e.g. "rule_ahcip_dx_linkage", "rule_modifier_25_missing"). Distinct
  // from `billingRuleReference` which is the human-readable citation
  // shown in the UI ("AMA CPT 2026 §99214"). ruleId is what
  // per-clinic calibration aggregates on — see src/lib/calibration.ts.
  // Nullable because older findings ingested before the 2026-06-27
  // scaffold may not have the field populated.
  ruleId                   String?
  // Set on dismiss with the chosen reason; null on accept. For
  // "other_with_text" the free-text body is in `dismissText` and must
  // be non-empty (enforced at the route layer with Zod).
  dismissReason            String?
  dismissText              String?  // AES-256-GCM ciphertext when present
  // Audit fields — the user that took the action and when.
  actionedByUserId         String?
  actionedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  encounter                Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  actionedBy               User?     @relation(fields: [actionedByUserId], references: [id], onDelete: SetNull)

  @@index([encounterId, status])
  @@index([encounterId, category])
  // Composite for the per-clinic calibration aggregation
  // (src/lib/calibration.ts). The query is "for this tenant, group
  // findings by ruleId and count accept/dismiss".
  @@index([ruleId])
}

// Append-only audit log. Every accept and dismiss writes exactly one
// row here. The hash chain is computed in src/lib/audit-chain.ts
// (port of src/audit_log.py) using the same GENESIS_PREVIOUS_SIGNATURE
// and CHAIN_FIELDS shape so the on-disk representation is identical
// regardless of the implementation language. Production DDL with the
// append-only trigger is in audit_trail.sql at the repo root.
model AuditTrailEntry {
  id                     String   @id @default(cuid())
  // Per-tenant chain — we never join across tenants in the walk.
  tenantId               String
  // Monotonically increasing, ties broken by event_id (cuid). The chain
  // walk sorts by (timestamp, event_id) so the order is deterministic.
  eventId                String   @unique @default(cuid())
  timestamp              DateTime @default(now())
  // The user that took the action. Populated from the auth session at
  // accept/dismiss time; null only for system-emitted events.
  userIdentifier         String
  // "accept" or "dismiss" — the action verbs on the finding card.
  action                 String
  // The finding this entry refers to. Indexed for the per-finding
  // history view (out of scope for this milestone, but the column
  // is cheap to keep and we want the FK).
  findingId              String
  // Optional reason payload for dismiss events. null on accept. The
  // reason is one of the dismiss reason values; for "other_with_text"
  // the text is in `reasonText`.
  reason                 String?
  reasonText             String?  // AES-256-GCM ciphertext when present
  // ---- Hash-chain payload fields ----
  // These four columns are part of the chain payload (see CHAIN_FIELDS
  // in src/lib/audit-chain.ts and the Python sibling src/audit_log.py).
  // They are persisted on the row so the on-site auditor can re-walk
  // and re-verify the chain offline without joining back to the
  // encounter table.
  //
  //   patientHash: SHA-256 hex of the patient identifier. We hash at
  //     ingest time so the row carries no PII. (Mirrors Encounter.patientHash.)
  //   dataElements: canonical JSON of { findingId, reason, reasonText }.
  //     The Python port asserts keys are sorted and the JSON is
  //     compact (no whitespace) so the digest is stable.
  //   modelRunId: for human review actions, "portal-review". For LLM
  //     audit actions, the run id of the auditor pass. The column
  //     exists so the chain shape does not change when we start
  //     writing LLM-driven rows.
  patientHash            String
  dataElements           String
  modelRunId             String
  // Hash chain link fields. previousSignature is 64 zeros on the first
  // row of each tenant chain; cryptographicSignature is the SHA-256
  // over (previous_signature || chain_payload) — see src/lib/audit-chain.ts.
  previousSignature      String
  cryptographicSignature String
  // The encounter the action is scoped to, kept for fast filtering
  // in the per-encounter audit panel.
  encounterId            String
  // Shared identifier for rows written by the same /findings bulk
  // action (accept / dismiss). Null for single-finding writes. The id
  // is also embedded in `dataElements` so the chain payload remains
  // canonical JSON; this column exists purely for the indexed
  // "show me everything from bulk action X" query on the billing
  // team / runbook review surface.
  bulkActionId           String?

  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter              Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp, eventId])
  @@index([findingId])
  @@index([encounterId])
  @@index([bulkActionId])
}

// ---------------------------------------------------------------------------
// Stripe webhook persistence models (t_c12cf722).
//
// ProcessedStripeEvent is the receiver-side dedup table. The webhook
// route inserts (eventId, type, receivedAt) on every accepted event;
// a duplicate delivery hits the unique index on eventId and the
// handler short-circuits with a 200 ack. The row is intentionally
// kept around (not deleted) so a forensic audit can see which events
// arrived and when. Cleanup is out of scope for this milestone; a
// future cron can prune rows older than N days.
//
// Invoice is the append-only log of paid Stripe invoices. Every
// invoice.payment_succeeded event upserts by stripeInvoiceId; the
// payloadJson column stores the full Stripe Invoice object so the
// billing UI can render line items without re-querying Stripe.
// ---------------------------------------------------------------------------

model ProcessedStripeEvent {
  id         String   @id @default(cuid())
  // Stripe's event id (evt_xxx). The unique index is the dedup
  // contract — every webhook handler runs inside a try/catch around
  // the createMany; a duplicate throws P2002 and we ack-and-skip.
  eventId    String   @unique
  // The Stripe event type (e.g. "invoice.payment_succeeded"). Stored
  // so the /billing admin view can show recent activity without
  // joining back to Tenant.
  type       String
  // Tenant the event was attributed to (nullable — events that
  // reference an unknown customer land here as null and are
  // logged-and-acked).
  tenantId   String?
  receivedAt DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, receivedAt])
  @@index([type, receivedAt])
}

model Invoice {
  id              String   @id @default(cuid())
  // Stripe's invoice id (in_xxx). The unique index is the upsert key
  // for invoice.payment_succeeded re-deliveries.
  stripeInvoiceId String   @unique
  // Stripe customer id this invoice belongs to. Indexed so the
  // /portal/billing page can list invoices for a tenant via
  // tenant.stripeCustomerId.
  stripeCustomerId String
  tenantId        String
  // Stripe subscription id (sub_xxx). Null on manual / one-off
  // invoices that aren't tied to a subscription. Indexed for the
  // subscription-detail join.
  stripeSubscriptionId String?
  // Stripe's status string at the time we received the event
  // (typically "paid" for payment_succeeded). Free-form because
  // Stripe's invoice status set is broader than our domain enum
  // would need.
  status          String
  // Amount in the smallest currency unit (cents for USD/CAD). Stored
  // as Int for arithmetic stability — never store money as Float.
  amountCents     Int
  currency        String
  // Full Stripe Invoice object (line items, period, etc.) so the UI
  // can render the detail view without a second Stripe round-trip.
  payloadJson     String
  // The Stripe event id that produced this row. Set on insert from
  // the webhook. Useful when debugging "why is this row showing
  // status=paid but the next event overwrote it" — a forensic view
  // can pull the originating event.
  createdFromEventId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// ---------------------------------------------------------------------------
// Email suppression list (t_a0c9352e).
//
// SuppressListEntry is the current-state table: a row here means
// "do not send any more email to this address until the row is
// removed." The unique index on `email` is the dedup contract — the
// Resend webhook handler upserts on conflict so a second bounce for
// the same address updates the existing row instead of stacking
// duplicates.
//
// Reasons:
//   - "bounce"      — Resend delivered a hard bounce. We refuse further
//                     sends of any kind (transactional or marketing) —
//                     a bounced transactional address is a sign the
//                     mailbox is dead and more sends will only damage
//                     sender reputation.
//   - "complaint"   — The recipient hit "Mark as spam" in their
//                     mailbox. Required by RFC 8058 / Gmail Postmaster
//                     guidance to never contact the address again
//                     unless the user re-subscribes through an
//                     explicit opt-in. Refused across all templates.
//   - "unsubscribe" — The recipient hit the List-Unsubscribe link in
//                     a marketing-adjacent email (welcome or
//                     weekly_digest). Per the spec this is the only
//                     reason that exempts password-reset and
//                     first-audit-complete (purely transactional) from
//                     suppression — the user only opted out of the
//                     marketing stream, not the security/operational
//                     stream. The send-time check in src/lib/email.ts
//                     encodes this exemption by template kind.
//
// SuppressionEvent is the append-only history. Every webhook hit
// (bounce, complaint, unsubscribe) writes one row here for forensic
// audit; SuppressListEntry is the upserted current-state. The
// separation is deliberate: keeping the history in a separate table
// means we can reason about suppression from a single current-state
// row without scanning all past events, and the history is still
// available for "when did this address get suppressed" answers.
// ---------------------------------------------------------------------------

model SuppressListEntry {
  id              String   @id @default(cuid())
  // Lowercased address — the send-time check lowercases its input
  // before looking up. Storing the lowercased form is the cheapest
  // way to keep that invariant.
  email           String   @unique
  // "bounce" | "complaint" | "unsubscribe"
  reason          String
  // Resend's event id (or the inbound POST's stamp for
  // List-Unsubscribe landing-page hits). Stored so a forensic
  // investigator can re-fetch the original event from Resend.
  sourceEventId   String?
  // Free-form reason payload (e.g. bounce diagnostic, complaint
  // feedback type). Helpful when triaging "why is this address
  // suppressed" without re-pulling the event.
  sourceDetail    String?
  createdAt       DateTime @default(now())
  // Updated when a subsequent event for the same email arrives
  // (e.g. a complaint landing on an address previously bounced).
  // lastEventAt gives "most recent signal" without scanning the
  // SuppressionEvent history.
  lastEventAt     DateTime @default(now())
}

model SuppressionEvent {
  id              String   @id @default(cuid())
  email           String
  // "bounce" | "complaint" | "unsubscribe"
  reason          String
  // Resend event id (or local uuid for the List-Unsubscribe page hit).
  sourceEventId   String?
  sourceDetail    String?
  // Full payload as JSON so a future forensic view can render the
  // original webhook body without a separate event log.
  payloadJson     String
  receivedAt      DateTime @default(now())

  @@index([email, receivedAt])
  @@index([reason, receivedAt])
}

// ---------------------------------------------------------------------------
// Marketing-site leads (t_fa2149e1).
//
// Public contact form on the marketing site stores a row per submission.
// Exactly the five fields the user submitted are persisted — no PII
// enrichment, no IP capture, no UA, no timestamps beyond createdAt
// (which the audit chain may want to correlate to inbound traffic;
// itself is non-PII).
//
// "billingSetup" is a 3-valued enum string ("in_house" | "outsourced"
// | "hybrid"). Stored as a plain string with a CHECK-equivalent
// validation in the API route (zod enum) so the schema stays portable
// to Postgres without a custom enum type.
//
// "claimVolume" is the slider value (0..100000, integer). Nullable
// for back-compat with a future "Prefer not to say" UX — current form
// makes it required, but a v2 may add a "Skip" button.
//
// No FK to User/Tenant — leads are pre-account. Once a lead converts,
// a future task can attach the lead id to the resulting Tenant/User
// via a linking table; out of scope here.
// ---------------------------------------------------------------------------

model Lead {
  id           String   @id @default(cuid())
  // Required, plain text. We don't enforce uniqueness — the same
  // clinic can submit multiple times; a downstream CRM dedup is
  // responsible for that, not this table.
  name         String
  // Required, plain text. Not lowercased at the schema layer so
  // the API can preserve user-supplied casing for display; the
  // disposable-email check lowercases a copy before lookup.
  clinicName   String
  // Required, lowercased on insert (API contract).
  email        String
  // Slider 0..100000. Null means "not provided".
  claimVolume  Int?
  // "in_house" | "outsourced" | "hybrid"
  billingSetup String
  createdAt    DateTime @default(now())

  // -----------------------------------------------------------------------------
  // Pipeline state (added 2026-06-28 per research/P0-PRODUCT-ROADMAP.md W1.2)
  //
  // Pre-2026-06-28 rows have NULL for all four. The Q3 lead-gen track requires
  // status + lastContactedAt to answer "how many leads, what's the conversion
  // rate" — without these, every pipeline question is unanswerable.
  //
  // No FK today (research/P5-customer-signal.md §1.1 confirmed): the Lead model
  // is intentionally user-scoped, not tenant-scoped, so adding these fields
  // doesn't introduce any referential complexity. Backfill is a no-op (41 fixture
  // rows already exist; their status defaults to 'new').
  // -----------------------------------------------------------------------------

  // Pipeline stage: "new" (just submitted, untouched) | "contacted"
  // (first outreach email/call sent) | "engaged" (replied or booked
  // a call) | "demo_scheduled" (demo on the calendar) | "pilot_signed"
  // (BAA / pilot agreement countersigned) | "lost" (closed without a
  // pilot — reason captured in `notes`). Strings (not a Prisma enum)
  // so we can add states without a schema migration; portal code
  // validates transitions.
  status            String   @default("new")

  // Origin channel — where this lead came from. "demo_request_form"
  // (the public /demo-request page) | "outbound_email" (manual entry
  // after a cold email gets a reply) | "channel_partner" (K&M
  // Medical Billing etc.) | "referral" (existing user / clinic
  // referred a colleague) | "imported" (CSV / spreadsheet import).
  source            String?

  // The user (if any) who owns this lead relationship. Null for unowned
  // / system-generated leads. Same FK semantics as User.id elsewhere.
  ownerUserId       String?

  // The most recent outreach action against this lead — used by the
  // pipeline dashboard's "X days since last contact" column.
  lastContactedAt   DateTime?
  // Optimistic-concurrency token for HQ mutations. Every successful update
  // increments this value; stale forms receive 409 instead of overwriting.
  version           Int      @default(0)
  // Explicit next work item. This is internal commercial context only; route
  // validation rejects clinical/claim content and caps the text length.
  nextAction        String?
  nextActionAt      DateTime?
  lostReason        String?

  activities LeadActivity[]

  @@index([email, createdAt])
  @@index([createdAt])
  // Used by the pipeline dashboard queries: filter by status + sort
  // by lastContactedAt desc for "stale" alerts (Research/P0-PRODUCT-ROADMAP.md
  // §6 decision log Q4 retrospective item).
  @@index([status, lastContactedAt])
  @@index([source])
  @@index([ownerUserId, nextActionAt])
}

// Immutable-by-application timeline of company actions on a lead. Mutation ids
// are supplied by the HQ client and make retried requests idempotent.
model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  actorUserId String?
  actorRole   String
  kind        String
  fromValue   String?
  toValue     String?
  mutationId  String
  occurredAt  DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([mutationId, kind])
  @@index([leadId, occurredAt])
  @@index([actorUserId, occurredAt])
}

// ---------------------------------------------------------------------------
// Per-clinic calibration signal (read-path scaffold, 2026-06-27)
//
// Background: docs/SPECIALTY_TUNING.md §2 lists "per-clinic F1 dashboard"
// as a precondition for triggering a re-tune. The FastAPI side has a
// feedback.py with calibration buckets (high/medium/low/uncalibrated) but
// those are computed on demand from the audit log. The portal needs its
// own read path so the dashboard can render "this rule is overcalled at
// your clinic" cards without a round-trip to the FastAPI.
//
// Design choice: this is a **read-side materialised view**, populated by
// the biller-action routes (findings accept/dismiss) via a write hook
// added in the same change. The schema is intentionally narrow — one
// row per (tenantId, ruleId), carrying the counts needed to bucket the
// rule for that clinic. We do NOT store free-text or per-finding detail
// here; the source-of-truth is still the Finding + AuditTrail tables.
//
// Bucket semantics (mirrors src/ai_billing_audit/feedback.py:280):
//   - acceptRate >= 0.70 → "calibrated"  (auditor's signal is trusted)
//   - 0.40 <= acceptRate < 0.70 → "reviewing"  (mixed signal, surface in UI)
//   - acceptRate < 0.40  → "overcalled" (auditor is firing this rule too
//     often for this clinic; worth per-clinic tuning)
//   - actedOn < MIN_ACTED_ON (5) → "uncalibrated" (not enough data yet)
//
// Last-updated column lets the dashboard flag stale signals (>30 days
// since last action) so the UI doesn't mislead the biller with year-old
// numbers. The FPAR tile already has the same staleness pattern.
// ---------------------------------------------------------------------------
model CalibrationSignal {
  id                 String   @id @default(cuid())
  tenantId           String
  ruleId             String
  acceptCount        Int      @default(0)
  dismissCount       Int      @default(0)
  // Acts as the "last time we observed a biller decision on this rule at
  // this clinic" timestamp. Drives the staleness check.
  lastSignalAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, ruleId])
  @@index([tenantId])
  @@index([ruleId])
  @@index([tenantId, lastSignalAt])
}
