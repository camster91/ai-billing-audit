# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Track the production env TEMPLATE so deploy-portal.sh has a known
# source. The populated .env.production must NEVER be committed — the
# deploy script writes it with chmod 600 and ssh scp, never via git.
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma generated client (regenerated on `prisma generate`)
/src/generated
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal

# Playwright E2E suite (CI artifacts, never commit)
/tests/e2e/screenshots/
/tests/e2e/playwright-report/
/tests/e2e/test-results/

# env / config backups (security)
*.bak
