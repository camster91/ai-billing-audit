{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate",
    "build": "ZORVA_BUILD_SKIP_DATABASE=1 next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretest:unit": "pnpm prisma:generate && DATABASE_URL=${DATABASE_URL:-file:./prisma/dev.db} prisma db push",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "node --import tsx --test tests/contact-form.test.ts tests/encounter-list-smoke.test.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "a11y:audit": "node a11y-audit.mjs",
    "hq:manage-role": "tsx scripts/manage-platform-role.ts",
    "a11y:keyboard": "node a11y-keyboard.mjs",
    "a11y:probe": "node a11y-probe-v2.mjs",
    "a11y:shots": "node a11y-shots.mjs",
    "perf:budgets": "node perf-budgets.mjs",
    "gate:all": "pnpm a11y:audit && pnpm perf:budgets",
    "tokens:check": "CHECK_TOKENS_STRICT=1 CHECK_TOKENS_CHANGED_ONLY=1 node scripts/check-design-tokens.mjs",
    "test:onboarding": "node --import tsx --test tests/onboarding.test.ts",
    "test:patient-hash": "node --import tsx --test tests/patient-hash.test.ts",
    "test:email": "node --import tsx --test tests/email.test.ts",
    "test:billing-page": "node --import tsx --test tests/billing-page.test.ts",
    "test:team-management": "node --import tsx --test tests/team-management.test.ts",
    "test:audit-quota": "node --import tsx --test tests/audit-quota.test.ts",
    "test:leads-direct": "node --import tsx --test tests/leads-direct.test.ts",
    "test:contact-form": "node --import tsx --test tests/contact-form.test.ts",
    "test:fpar": "node --import tsx --test tests/fpar.test.ts",
    "test:calibration": "node --import tsx --test tests/calibration.test.ts",
    "test:calibration-upsert": "node --import tsx --test tests/calibration.upsert.test.ts",
    "test:api-errors": "node --import tsx --test tests/api-errors.test.ts",
    "test:database-runtime": "node --import tsx --test tests/database-runtime.test.ts",
    "test:fastapi-principal": "node --import tsx --test tests/fastapi-principal.test.ts",
    "test:data-encryption": "node --import tsx --test tests/data-encryption.test.ts",
    "test:portal-phi-migration": "node --import tsx --test tests/portal-phi-migration.test.ts",
    "test:portal-workflow-safety": "node --import tsx --test tests/portal-workflow-safety.test.ts",
    "test:audit-engine": "node --import tsx --test tests/audit-engine.test.ts",
    "test:audit-results": "node --import tsx --test tests/audit-results.test.ts",
    "prisma:prepare-postgresql": "node scripts/prepare-postgresql-schema.mjs",
    "prisma:generate": "pnpm prisma:prepare-postgresql && prisma generate && prisma generate --config prisma.postgresql.config.ts",
    "prisma:migrate:deploy:postgresql": "pnpm prisma:generate && prisma migrate deploy --config prisma.postgresql.config.ts",
    "migrate:portal-phi": "node --import tsx scripts/migrate-portal-phi.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-sqlite3": "12.11.1",
    "next": "15.5.21",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "6.12.4",
    "stripe": "22.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.61.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "prisma": "7.9.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "sharp": "0.35.0",
      "postcss": "8.5.23"
    }
  }
}
