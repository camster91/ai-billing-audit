# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Prisma reads this via prisma.config.ts. The runtime client in
# src/lib/prisma.ts also reads it to construct the better-sqlite3 adapter.
DATABASE_URL="file:./prisma/dev.db"
# For production, point at the ca-central-1 or us-east-1 Postgres cluster.

# ---------------------------------------------------------------------------
# NextAuth.js (Auth.js v5)
# ---------------------------------------------------------------------------
# AUTH_SECRET signs the session cookie. Auto-detected by next-auth.
# Generate a real one for production with: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL is auto-detected. Override for canonical URLs behind a reverse
# proxy. Leave commented for local dev. Format: scheme://host[:port]
# AUTH_URL="https://example.com"

# ---------------------------------------------------------------------------
# Resend (magic-link email delivery)
# ---------------------------------------------------------------------------
# Sign up at https://resend.com, create an API key, and verify your sending
# domain. When AUTH_RESEND_KEY is blank, the auth config falls back to
# logging the magic link to the terminal — useful for local dev / CI.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="AI Billing Portal <noreply@example.com>"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical base URL used to build success_url / cancel_url for Stripe
# Checkout and the return_url for the Customer Portal. Leave commented
# for local dev — the API routes fall back to the request's own origin.
# BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe (test mode)
# ---------------------------------------------------------------------------
# Get test keys from https://dashboard.stripe.com/test/apikeys.
# In demo mode (both Stripe vars blank/placeholder), the checkout API
# returns a stub URL pointing at /portal/onboarding and the webhook route
# refuses to process events — so the dev loop never silently provisions
# tenants without a real key configured.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Get the webhook secret from `stripe listen --forward-to ...` during
# local dev, or from the dashboard endpoint settings in production.
STRIPE_WEBHOOK_SECRET=""

# -------------------------------------------------------------------
# Patient-hash pepper (PHI protection)
# -------------------------------------------------------------------
# Server-side secret mixed into SHA-256 before the patient identifier
# when computing the `patientHash` column on `encounter` and the
# `patient_hash` field in `audit_trail`. Rotating this invalidates
# every existing hash, which is the right response to a suspected
# breach. In production the value MUST be set to 16+ chars or the
# app will refuse to boot (see apps/portal/src/lib/patient-hash.ts).
# Leave commented in dev — the helper falls back to a constant
# outside production.
# Generate with: openssl rand -base64 24
# PATIENT_HASH_PEPPER=""

# -------------------------------------------------------------------
# Pricing (Zorva §11 — AKS/Stark safe-harbor flat-fee 3-tier)
# -------------------------------------------------------------------
# Currency display order on /pricing (primary shown first, secondary below).
PRICING_CURRENCY_PRIMARY="CAD"
PRICING_CURRENCY_SECONDARY="USD"

# Per-tier knobs. Defaults match Zorva §11 if you remove the override.
# Names appear as the tier heading; audit caps drive the "Up to N audits /
# month" line and the per-tenant quota limit.

# --- Small practice ($499 CAD / $369 USD, 500 audits/mo) ---
PRICING_TIER_SMALL_NAME="Small practice"
PRICING_TIER_SMALL_AUDIT_CAP="500"
PRICING_TIER_SMALL_PRICE_CAD="499"
PRICING_TIER_SMALL_PRICE_USD="369"
# Stripe price IDs for test mode. Create in the Stripe dashboard:
#   https://dashboard.stripe.com/test/products
# Both CAD and USD are required for the page's dual-currency layout.
PRICING_TIER_SMALL_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_SMALL_STRIPE_PRICE_ID_USD=""

# --- Mid clinic ($1,499 CAD / $1,109 USD, 2,000 audits/mo) ---
PRICING_TIER_MID_NAME="Mid clinic"
PRICING_TIER_MID_AUDIT_CAP="2000"
PRICING_TIER_MID_PRICE_CAD="1499"
PRICING_TIER_MID_PRICE_USD="1109"
PRICING_TIER_MID_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_MID_STRIPE_PRICE_ID_USD=""

# --- Large practice ($2,999 CAD / $2,219 USD, 5,000 audits/mo) ---
PRICING_TIER_LARGE_NAME="Large practice"
PRICING_TIER_LARGE_AUDIT_CAP="5000"
PRICING_TIER_LARGE_PRICE_CAD="2999"
PRICING_TIER_LARGE_PRICE_USD="2219"
PRICING_TIER_LARGE_STRIPE_PRICE_ID_CAD=""
PRICING_TIER_LARGE_STRIPE_PRICE_ID_USD=""

# -------------------------------------------------------------------
# Platform admin (quota mutation)
# -------------------------------------------------------------------
# Comma-separated emails allowed to PUT /api/billing/tiers (platform-
# wide audit-quota defaults). Leave blank to fail-closed (503).
# PLATFORM_ADMIN_EMAILS="ops@example.com"
