apps/portal/insert-session.mjs
apps/portal/test-results/

# User-uploaded clinical notes (PHI — never commit)
logs/uploaded_notes/

# Acceptance-run result bundles (kept locally for analysis)
runs/acceptance/ab-*/
runs/acceptance/multi-*/
runs/acceptance/live-parity/

# Junk files from mis-quoted shell commands
" if v else \"\"}\"\"')\n"

