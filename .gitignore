# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / dist
build/
dist/
*.egg-info/
*.egg

# Virtualenv
.venv/
venv/
env/
ENV/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# Tooling
.idea/
.vscode/
.DS_Store

# Secrets and runtime artifacts (v0.1.0-rc1 mirror)
.env
.env.local
.env.*.local
logs/*.jsonl
artifacts/*_prog
node_modules/
.next/

# apps/portal is a separate Next.js stack — not part of the api/worker image
# but we still keep the source tree under apps/ for context. node_modules
# inside apps/portal is excluded by the node_modules/ rule above.

# Acceptance-run artifacts (per-provider prediction JSONLs and metadata).
# The comparison.{json,md} and VERDICT.txt at the top of runs/acceptance/
# SHOULD be committed as evidence of the acceptance run; only the
# per-provider run dirs (which are large and dated) are ignored.
runs/acceptance/minimax-*/
runs/acceptance/claude-*/
runs/acceptance/openai-*/
runs/acceptance/gemini-*/

# Stray bearer-token scratch files and env backups (security)
*.tmp_bearer.txt
.env.bak
